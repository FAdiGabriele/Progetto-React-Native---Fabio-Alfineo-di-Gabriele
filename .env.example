# NewsAPI key (get one at https://newsapi.org/register).
# Copy this file to .env, fill in the value and restart the dev server.
EXPO_PUBLIC_NEWS_API_KEY=

# Optional fixture mode: set to true to serve the fixtures of services/fixtures/
# instead of calling NewsAPI, with no requests sent and no key needed.
# Leave it empty to use NewsAPI. Restart the dev server after every change.
EXPO_PUBLIC_NEWS_USE_FIXTURES=
